# Optional local settings. npm dev/start commands load .env automatically.
PORT=8081
TRUSTED_HOSTS=localhost,127.0.0.1
# DATABASE=data/custom.sqlite3
# Production only: generate scrypt hashes with npm run users --silent
# ROUTING_USERS={"admin":{"role":"admin","password_hash":"scrypt$..."}}
# HOST=127.0.0.1

# Generate a random token: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# MONITOR_TOKEN=your-random-token-of-at-least-32-characters
# TRUST_PROXY=loopback
# ALERT_WEBHOOK=https://your-alert-receiver.example/webhook
