{
  "name": "parceldesk",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts --demo",
    "dev:client": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "start:demo": "node --env-file-if-exists=.env dist/server/index.js --demo",
    "test": "node --import tsx --test tests/*.test.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "users": "node --import tsx scripts/create-users.ts",
    "monitor": "node --import tsx scripts/monitor.ts",
    "package": "node scripts/package.mjs",
    "backup": "node --import tsx scripts/backup.ts",
    "feature:demo": "node --import tsx scripts/feature-workflow.ts",
    "lint": "eslint server client/src shared tests scripts *.ts",
    "format": "prettier --write server client shared tests scripts *.ts *.json *.mjs .github README.md docs/*.md",
    "format:check": "prettier --check server client shared tests scripts *.ts *.json *.mjs .github README.md docs/*.md",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "node --import tsx --experimental-test-coverage --test-coverage-include=\"server/**/*.ts\" --test-coverage-exclude=\"server/index.ts\" --test-coverage-lines=75 --test-coverage-functions=70 --test-coverage-branches=65 --test tests/*.test.ts"
  },
  "dependencies": {
    "cookie": "^1.0.2",
    "decimal.js": "^10.6.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.0",
    "helmet": "^8.1.0",
    "json-dup-key-validator": "^1.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^9.2.0",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "fflate": "^0.8.2",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.0",
    "vitest": "^5.0.1"
  }
}
